{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TmuxDeck",
  "version": "1.14.8",
  "identifier": "com.ctliz.tmuxdeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "TmuxDeck",
        "width": 1160,
        "height": 780,
        "minWidth": 850,
        "minHeight": 550,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "tray-panel",
        "title": "TmuxDeck Panel",
        "url": "tray.html",
        "width": 380,
        "height": 560,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 16
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/ctliz-agent-intercom-core-0.2.0.tgz",
      "resources/ctliz-agent-intercom-claude-0.13.0-connect.1.tgz",
      "resources/ctliz-agent-intercom-codex-0.12.0-connect.1.tgz",
      "resources/ctliz-agent-intercom-opencode-0.12.0-connect.1.tgz",
      "resources/opencode-ai-plugin-1.18.18.tgz",
      "resources/opencode-sdk-closure.tgz"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
