{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the tray panel",
  "windows": [
    "main",
    "tray-panel"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "notification:default",
    "updater:default",
    "process:default"
  ]
}